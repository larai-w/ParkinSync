# Ignore Python bytecode
__pycache__/
*.py[cod]
.pytest_cache/

# Ignore sensitive credential files (Very Important!)
*.json
# Public product metadata is intentionally reviewed and tracked.
!product.json
# Public synthetic-fixture provenance is intentionally reviewed and tracked.
!analytics/synthetic_fixture_manifest.json
# Reviewed deterministic FHIR demo inputs and outputs are synthetic public artifacts.
!fhir/*.json
!fhir/generated/*.json
# Reviewed deterministic grounded-summary evidence is synthetic and public.
!fhir/summary/*.json
!fhir/summary/generated/*.json
# Reviewed deterministic seven-day FHIR evidence is synthetic and public.
!fhir/weekly/*.json
!fhir/weekly/generated/*.json
# Reviewed ephemeral-server contract contains public synthetic-test metadata only.
!fhir/server/*.json
# Reviewed NZ Base derivative artifacts contain synthetic records only.
!fhir/nzbase/*.json
!fhir/nzbase/generated/*.json
# Reviewed JP Core derivative artifacts contain synthetic records only.
!fhir/jpcore/*.json
!fhir/jpcore/generated/*.json
.env
secret_key.txt

# Ignore local IDE settings
.vscode/
.idea/

# Ignore AWS Lambda deployment artifacts (Managed via deploy.sh)
package/
*.zip

# Ignore Python virtual environments
.venv/
venv/

# Ignore macOS metadata
.DS_Store

# Ignore local scratch files not part of the project
Capstone/
README 2.md
local-drafts/
analytics/features_*.csv
analytics/care_daily_summary.csv
analytics/weekly_insights.md
analytics/exports/
analytics/features_integrated.csv

# blog drafts kept private (see veai-jp-web/docs-private/drafts)
content/blog-drafts/

# --- 非公開の作業ドキュメント（公開フォルダに置いても追跡しない安全策）---
docs-private/
.private/
private/
*-private.md
**/WORKLOG*.md
**/*HANDOFF*.md
**/*-todo.md
